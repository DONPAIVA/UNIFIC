# ============================================================================
# Unific+ / CentralML — variáveis de ambiente
# ============================================================================
# Copie para `.env` e preencha. NÃO comite o `.env`.
#
# ATENÇÃO — o arquivo `.env` NÃO pode ter BOM (UTF-8 with BOM).
# Com BOM, a primeira variável é lida como "﻿ML_CLIENT_ID" e o OAuth
# falha silenciosamente. Salve sempre como "UTF-8" simples.
# ============================================================================

# ----------------------------------------------------------------------------
# Mercado Livre — SOMENTE servidor. Nunca prefixe com VITE_.
# ----------------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Redirect URI cadastrada no aplicativo do Mercado Livre.
# Em desenvolvimento: http://localhost:8080/api/public/ml/callback
# Em produção: <seu domínio>/api/public/ml/callback
# Deve ser IDÊNTICA aos dois lados (aqui e no painel do Mercado Livre).
ML_REDIRECT_URI=http://localhost:8080/api/public/ml/callback

# Base pública da aplicação. Se vazio, o servidor usa a origem da requisição.
# Usada para montar a URL do webhook e do cron.
APP_URL=http://localhost:8080

# PKCE no OAuth: "on" para ligar. Deixe vazio se o aplicativo do ML não usa.
ML_USE_PKCE=

# ----------------------------------------------------------------------------
# Rotas internas (/internal/*) — SOMENTE servidor.
# Header exigido: x-internal-token
# ----------------------------------------------------------------------------
ML_INTERNAL_API_TOKEN=

# Cron de sincronização (/api/public/ml/cron). Vazio = cron desabilitado.
ML_CRON_TOKEN=
ML_CRON_MIN_MINUTES=30

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SEGREDO. Só no servidor. Nunca prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Expostas ao navegador (o prefixo VITE_ as coloca no bundle público).
# Só a URL e a chave PUBLICÁVEL podem receber esse prefixo.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# CentralML
# ----------------------------------------------------------------------------
# Primeiro administrador. O e-mail precisa ser de um usuário que já exista em
# Authentication > Users. Só tem efeito ENQUANTO a tabela admin_users estiver
# vazia — depois disso, novos admins são cadastrados pela própria CentralML.
ADMIN_BOOTSTRAP_EMAIL=
